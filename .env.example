# ─── Server ──────────────────────────────────────────────────
# Port the server listens on (default: 3000)
PORT="3000"

# Environment: "development", "production", or "test" (default: "development")
NODE_ENV="development"

# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string (required)
# Must use postgresql:// or postgres:// protocol
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# ─── Authentication (Better Auth) ────────────────────────────
# Base URL where Better Auth routes are mounted (default: "http://localhost:3000")
# Include path if mounted on a sub-path, e.g. "http://localhost:3000/api/v1/auth"
BETTER_AUTH_URL="http://localhost:3000"

# Secret for signing tokens — must be at least 32 characters (required)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-secret-at-least-32-characters"

# Comma-separated list of trusted origins for CORS (optional)
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# ─── Email (Google SMTP) ─────────────────────────────────────
# Google app password for sending transactional emails (optional)
GOOGLE_APP_PASS=""

# Google account email used as SMTP sender (optional)
GOOGLE_APP_USER="user@gmail.com"

# ─── Logging ─────────────────────────────────────────────────
# Log level: "fatal", "error", "warn", "info", "debug", "trace" (default: "info")
LOG_LEVEL="info"

# ─── Observability (Better Stack) ────────────────────────────
# Better Stack source token for log ingestion (optional)
BETTER_STACK_SOURCE_TOKEN=""

# Better Stack custom ingestion endpoint host (optional)
BETTER_STACK_INGESTING_HOST=""

{
  "name": "task-manager",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "format": "bun biome format --write .",
    "lint": "bun biome lint .",
    "fix": "bun biome check --write .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:auth": "better-auth generate -y --output src/modules/auth/auth.schema.ts --config src/config/auth.ts",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.0.2",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^1.0.0-rc.4",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.32",
    "hono-pino": "^0.10.3",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@biomejs/biome": "2.5.5",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^1.0.0-rc.4",
    "typescript": "^7.0.2"
  }
}
